{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-check.mjs"
            ]
          },
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-check.mjs"
            ]
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "code-review|review",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/mark-code-reviewed.mjs"
            ]
          }
        ]
      }
    ]
  }
}
